# Database Configuration
DB_HOST=localhost
DB_NAME=your_database_name
DB_USER=your_database_user
DB_PASSWORD=your_secure_database_password
DB_CHARSET=utf8mb4

# Encryption Keys (Generate using: php tools/setkey.php)
KEY="your_32_byte_base64_encoded_key_here"
ENCRYPTION_KEY="your_32_byte_base64_encoded_key_here"

# Application Environment
APP_ENV=development

# Session Configuration
SESSION_LIFETIME=3600
REMEMBER_LIFETIME=2592000

# JWT Configuration  
JWT_ISSUER=your-app-name
JWT_EXPIRY=3600

# Security Logging
SECURITY_LOGGING_ENABLED=true
SECURITY_LOG_PATH=/var/log/php-mvc-security.log